NODE_ENV=development
PORT=3000

# Runtime de Express/Prisma Client: usa la cadena pooled de Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Prisma CLI/migraciones: usa la cadena directa de Neon, sin -pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Brevo SMTP para códigos de verificación y recuperación de contraseña
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER="usuario_smtp_de_brevo"
EMAIL_PASSWORD="smtp_key_de_brevo"
EMAIL_FROM="correo_remitente_verificado"

# API HTTPS para Brevo cuando Railway bloquea SMTP
BREVO_API_KEY=""

# Gemini se configura solo en Railway; nunca la guardes en Flutter o GitHub.
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.8-flash

